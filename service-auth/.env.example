# Servidor
NODE_ENV=development
PORT=3001

# PostgreSQL (docker-compose del servicio)
DB_HOST=localhost
DB_PORT=5436
DB_NAME=IAuth
DB_USERNAME=root
DB_PASSWORD=admin
DB_SQL_LOGGING=false

# JWT (debe coincidir con inventory y reports)
JWT_SECRET=JWTSECRETOnoEmail!
JWT_EXPIRES_IN=8h

# Correo (opcional - verificación / reset)
EMAIL_USER=
EMAIL_PASS=

# Frontend
FRONTEND_URL=http://localhost:5173
